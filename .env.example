# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=business@bloxistar.com
RESEND_FROM_NAME=BloxStar
RESEND_REPLY_TO=business@bloxistar.com

# Admin accounts (server only)
ADMIN_EMAILS=admin@example.com

# MoonPay server verification (server only)
MOONPAY_SECRET_KEY=sk_live_xxxxxxxxxxxx
MOONPAY_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Google OIDC
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://www.bloxistar.com/api/public/auth/google/callback
# Optional issuer/JWKS overrides for controlled testing only
# GOOGLE_ISSUER=https://accounts.google.com
# GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# Canonical application origin
APP_ORIGIN=https://www.bloxistar.com
# Optional: extra origins allowed to call the API (comma separated)
# ALLOWED_ORIGINS=https://bloxistar.com


# Email sending uses the direct Resend API key above.
